              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Estrutura data + meta', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data').that.is.an('array');",
                  "  pm.expect(body).to.have.property('meta');",
                  "  pm.expect(body.meta).to.have.property('total');",
                  "});",
                  "pm.test('Seed com 10 equipes', function () {",
                  "  pm.expect(pm.response.json().meta.total).to.be.at.least(10);",
                  "});",
                  "pm.test('Primeira equipe salvo para referencia', function () {",
                  "  var d = pm.response.json().data[0];",
                  "  pm.collectionVariables.set('seedTeamId', d.id);",
                  "});"
