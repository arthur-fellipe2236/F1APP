{
  "installCommand": "cd f1-app && npm install --legacy-peer-deps",
  "buildCommand": "cp -rf f1-api/app/* api/app/ && cp -f f1-api/instance/f1.db api/instance/f1.db && cd f1-app && npm run build",
  "outputDirectory": "f1-app/dist",
  "functions": {
    "api/**": {
      "includeFiles": "api/**",
      "excludeFiles": "{book-translator/**,f1-iframe-extension/**,f1-api/**,f1-app/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
