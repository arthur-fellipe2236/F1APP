# f1-api — variaveis locais de desenvolvimento (copiar para .env; NUNCA commitar)
#
# Banco: cada branch do Supabase (dev / preview / production) tem SUA
# connection string — troque conforme o ambiente:
#   production -> db principal   |  preview/dev -> db das branches
F1_DATABASE_URI=postgresql+psycopg2://postgres.<ref>:<senha>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#
# Vercel Redis (Storage > Redis): opcional — sem ele a API usa cache em memoria
REDIS_URL=
#
# Vercel Blob "f1app-imagem" (Storage > Blob > f1app-imagem > Settings >
# Read-write token): sem ele o /media/proxy serve WebP direto, sem espelhar no bucket
BLOB_READ_WRITE_TOKEN=
