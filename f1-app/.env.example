# URL base para chamadas de API (Backend / OpenF1)
# Caso não seja definido, o Vite utilizará o proxy interno (http://localhost:5000/api) 
# em ambiente de desenvolvimento, e chamadas relativas em produção.
VITE_API_URL=http://localhost:5000

# Spotify API (Client ID para login PKCE na Rádio F1 - opcional)
# Obtenha gratuitamente em https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
